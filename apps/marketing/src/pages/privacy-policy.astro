---
import LegalPage from "../components/LegalPage.astro";
import { PRIVACY_POLICY_URL, PRODUCT_NAME, PUBLISHER_NAME, SUPPORT_EMAIL } from "../lib/site";

const sections = [
  ["policy", "Which policy applies"],
  ["usage-data", "Product usage data"],
  ["contact", "Contact us"],
] as const;
---

<LegalPage
  title={`Privacy Policy | ${PRODUCT_NAME}`}
  description={`How ${PRODUCT_NAME} handles your information.`}
  heading="Privacy Policy"
  lede={`${PRODUCT_NAME} is published by ${PUBLISHER_NAME}. ${PUBLISHER_NAME}'s Privacy Policy explains how your information is handled.`}
  sections={sections}
>
  <section id="policy">
    <p class="section-number">01</p>
    <h2>Which policy applies</h2>
    <p>
      {PUBLISHER_NAME}'s Privacy Policy covers {PRODUCT_NAME}, this website and any AmICited account
      you connect to it:{" "}<a href={PRIVACY_POLICY_URL}>{PRIVACY_POLICY_URL}</a>.
    </p>
  </section>

  <section id="usage-data">
    <p class="section-number">02</p>
    <h2>Product usage data</h2>
    <p>
      {PRODUCT_NAME} runs on your computer. Your chats, files and provider sign-ins stay there. The
      app sends product usage events, without prompts, responses or file contents, and you can turn
      them off in Settings.
    </p>
  </section>

  <section id="contact">
    <p class="section-number">03</p>
    <h2>Contact us</h2>
    <p>
      Privacy questions and requests go to{" "}<a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a>.
    </p>
  </section>
</LegalPage>
