---
import LegalPage from "../components/LegalPage.astro";
import {
  PRODUCT_NAME,
  PUBLISHER_NAME,
  SECURITY_EMAIL,
  SECURITY_POLICY_URL,
} from "../lib/site";

const sections = [
  ["reporting", "Reporting security issues"],
  ["policy", "Security policy"],
] as const;
---

<LegalPage
  title={`Security Policy | ${PRODUCT_NAME}`}
  description={`How to report a security issue in ${PRODUCT_NAME}.`}
  heading="Security Policy"
  lede={`${PRODUCT_NAME} is published by ${PUBLISHER_NAME}. Report security issues privately by email.`}
  sections={sections}
>
  <section id="reporting">
    <p class="section-number">01</p>
    <h2>Reporting security issues</h2>
    <p>
      If you believe you have found a security vulnerability in {PRODUCT_NAME}, email{" "}
      <a href={`mailto:${SECURITY_EMAIL}`}>{SECURITY_EMAIL}</a>. Please do not disclose it publicly
      until we have had a reasonable chance to investigate and fix it.
    </p>
    <p>Please include, when available:</p>
    <ul>
      <li>A description of the issue and its potential impact;</li>
      <li>The affected version, platform and component;</li>
      <li>Clear reproduction steps or a minimal proof of concept; and</li>
      <li>Relevant logs or screenshots, with secrets removed.</li>
    </ul>
  </section>

  <section id="policy">
    <p class="section-number">02</p>
    <h2>Security policy</h2>
    <p>
      {PUBLISHER_NAME}'s security policy describes how {PUBLISHER_NAME} protects its services:{" "}
      <a href={SECURITY_POLICY_URL}>{SECURITY_POLICY_URL}</a>.
    </p>
  </section>
</LegalPage>
