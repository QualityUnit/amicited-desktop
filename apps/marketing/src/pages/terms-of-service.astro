---
import LegalPage from "../components/LegalPage.astro";
import { PRODUCT_NAME, PUBLISHER_NAME, SUPPORT_EMAIL, TERMS_URL } from "../lib/site";

const sections = [
  ["terms", "Which terms apply"],
  ["contact", "Contact us"],
] as const;
---

<LegalPage
  title={`Terms of Service | ${PRODUCT_NAME}`}
  description={`The terms that govern your use of ${PRODUCT_NAME}.`}
  heading="Terms of Service"
  lede={`${PRODUCT_NAME} is published by ${PUBLISHER_NAME}. ${PUBLISHER_NAME}'s Terms and Conditions govern your use of it.`}
  sections={sections}
>
  <section id="terms">
    <p class="section-number">01</p>
    <h2>Which terms apply</h2>
    <p>
      Your use of {PRODUCT_NAME}, this website and any AmICited account you connect to it is
      governed by {PUBLISHER_NAME}'s Terms and Conditions:{" "}
      <a href={TERMS_URL}>{TERMS_URL}</a>.
    </p>
    <p>
      {PRODUCT_NAME} runs AI providers you sign in to yourself, such as Claude or ChatGPT. Your use of
      those providers is governed by their own terms.
    </p>
  </section>

  <section id="contact">
    <p class="section-number">02</p>
    <h2>Contact us</h2>
    <p>
      Questions about these terms go to{" "}<a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a>.
    </p>
  </section>
</LegalPage>
