{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "globalDate": "off",
          "cryptoRandomUUID": "off",
          "globalTimers": "off",
          "extendsNativeError": "off",
          "globalConsole": "off",
          "globalFetch": "off",
          "nodeBuiltinImport": "off"
        }
      }
    ]
  },
  "include": ["src"]
}
