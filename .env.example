# Optional: AmICited Link source builds
# AmICited Link (remote access through a relay) is off unless every value below is
# set. AmICited runs no relay or account service yet, so leave them empty for a
# local build. Values are public identifiers, not secrets.
# Do not add server-side secrets to this file.

# Clerk instance for AmICited accounts: the publishable key, JWT template and CLI
# OAuth client from the Clerk Dashboard.
# TODO(amicited-infra): fill in once AmICited has its own Clerk instance.
# AMICITED_CLERK_PUBLISHABLE_KEY=
# AMICITED_CLERK_JWT_TEMPLATE=
# AMICITED_CLERK_CLI_OAUTH_CLIENT_ID=

# Optional: signed macOS passkey builds. The RP domain defaults to the Frontend API
# hostname encoded in the Clerk publishable key. Set the override only when Clerk
# returns a different RP ID or when multiple domains must be entitled.
# T3CODE_APPLE_TEAM_ID=
# T3CODE_MACOS_PROVISIONING_PROFILE=/absolute/path/to/amicited.provisionprofile
# T3CODE_CLERK_PASSKEY_RP_DOMAINS=

# Relay origin. `infra/relay` deploys print it.
# TODO(amicited-infra): fill in once AmICited runs its own relay.
# AMICITED_RELAY_URL=

# Optional: hosted web app origin for shareable thread and prompt links and the
# CLI's browser sign-in. Without it, links open the desktop app and the CLI signs
# in with a device code. The server reads T3CODE_HOSTED_APP_URL at runtime and the
# web build reads VITE_HOSTED_APP_URL; set both to the same origin.
# T3CODE_HOSTED_APP_URL=
# VITE_HOSTED_APP_URL=

# Optional: public, ingest-only OpenTelemetry for the mobile app and relay client.
# Without these, nothing is exported.
# AMICITED_MOBILE_OTLP_TRACES_URL=
# AMICITED_MOBILE_OTLP_TRACES_DATASET=
# AMICITED_MOBILE_OTLP_TRACES_TOKEN=
